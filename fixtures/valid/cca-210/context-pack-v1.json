      "states": [
        "idle",
        "received"
      ],
      "fields": [
        "synthetic-message"
      ]
    },
    {
      "id": "component.synthetic.sender",
      "kind": "synthetic-component",
      "states": [
        "idle",
        "sent"
      ],
      "fields": [
        "synthetic-message"
      ]
    }
  ],
  "morphisms": [
    {
      "id": "morphism.synthetic.transfer",
      "input": {
        "state": "sent"
      },
      "output": {
        "state": "received"
