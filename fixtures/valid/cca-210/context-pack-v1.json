      "pre": [
        "Synthetic input is fixture data."
      ],
      "post": [
        "Synthetic output remains fixture data."
      ],
      "failures": [
        "No live behavior is represented."
      ]
    }
  ],
  "diagrams": [
    {
      "id": "diagram.synthetic.flow",
