{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itdojp/crypto-communications-assurance/schema/cryptocomm-resolved-profile-v1.schema.json",
  "title": "Cryptographic Communication Resolved Profile v1",
  "description": "Closed deterministic expansion of a profile request. Resolution outcomes are descriptive and confer no execution, evidence, approval, product-security, certification, or release meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "state",
    "inputBindings",
    "requestedModules",
    "modules",
    "selections",
    "assumptions",
    "exclusions",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cryptocomm-resolved-profile/v1"
    },
    "profileId": {
      "$ref": "#/$defs/profileId"
    },
    "state": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleCatalog",
        "propertyCatalog",
        "attackerCatalog",
        "threatCatalog"
      ],
      "properties": {
        "moduleCatalog": {
          "$ref": "#/$defs/moduleCatalogBinding"
        },
        "propertyCatalog": {
          "$ref": "#/$defs/propertyCatalogBinding"
        },
        "attackerCatalog": {
          "$ref": "#/$defs/attackerCatalogBinding"
        },
        "threatCatalog": {
          "$ref": "#/$defs/threatCatalogBinding"
        }
      }
    },
    "requestedModules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 96,
      "propertyNames": {
        "$ref": "#/$defs/moduleId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/moduleOutcome"
      }
    },
    "selections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "properties",
        "capabilities",
        "attackers",
        "threats"
      ],
      "properties": {
        "properties": {
          "$ref": "#/$defs/propertySelectionMap"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilitySelectionMap"
        },
        "attackers": {
          "$ref": "#/$defs/attackerSelectionMap"
        },
        "threats": {
          "$ref": "#/$defs/threatSelectionMap"
        }
      }
    },
    "assumptions": {
      "$ref": "#/$defs/sourceStatements"
    },
    "exclusions": {
      "$ref": "#/$defs/sourceStatements"
    },
    "fixtureClassification": {
      "const": "synthetic-test-only"
    },
    "safety": {
      "$ref": "#/$defs/safetyBoundary"
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+(?:\\.(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "catalogBindingBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "catalogId",
        "catalogVersion",
        "digest"
      ],
      "properties": {
        "contractId": {
          "type": "string"
        },
        "catalogId": {
          "$ref": "#/$defs/catalogId"
        },
        "catalogVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "moduleCatalogBinding": {
      "$ref": "#/$defs/catalogBindingBase",
      "type": "object",
      "properties": {
        "contractId": {
          "const": "cryptocomm-capability-module-catalog/v1"
        }
      }
    },
    "propertyCatalogBinding": {
      "$ref": "#/$defs/catalogBindingBase",
      "type": "object",
      "properties": {
        "contractId": {
          "const": "cryptocomm-property-catalog/v1"
        }
      }
    },
    "attackerCatalogBinding": {
      "$ref": "#/$defs/catalogBindingBase",
      "type": "object",
      "properties": {
        "contractId": {
          "const": "cryptocomm-attacker-catalog/v1"
        }
      }
    },
    "threatCatalogBinding": {
      "$ref": "#/$defs/catalogBindingBase",
      "type": "object",
      "properties": {
        "contractId": {
          "const": "cryptocomm-threat-catalog/v1"
        }
      }
    },
    "moduleId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^module\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "profileId": {
      "type": "string",
      "minLength": 11,
      "maxLength": 128,
      "pattern": "^profile\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "propertyId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^property\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 14,
      "maxLength": 128,
      "pattern": "^capability\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "attackerId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 96,
      "pattern": "^attacker\\.([a-z][a-z0-9-]{0,63})$"
    },
    "threatId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^threat\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "outcomeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "requested",
        "requiredBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/moduleId"
        },
        "state": {
          "type": "string"
        },
        "requested": {
          "type": "boolean"
        },
        "requiredBy": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleId"
          }
        }
      }
    },
    "resolvedOutcome": {
      "$ref": "#/$defs/outcomeBase",
      "type": "object",
      "properties": {
        "state": {
          "const": "resolved"
        }
      }
    },
    "unknownOutcome": {
      "$ref": "#/$defs/outcomeBase",
      "type": "object",
      "properties": {
        "state": {
          "const": "unknown"
        }
      }
    },
    "unsupportedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "requested",
        "requiredBy",
        "reason",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/moduleId"
        },
        "state": {
          "const": "unsupported"
        },
        "requested": {
          "type": "boolean"
        },
        "requiredBy": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleId"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "unresolvableOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "requested",
        "requiredBy",
        "conflictsWith",
        "unresolvedDependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/moduleId"
        },
        "state": {
          "const": "unresolvable"
        },
        "requested": {
          "type": "boolean"
        },
        "requiredBy": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleId"
          }
        },
        "conflictsWith": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleId"
          }
        },
        "unresolvedDependencies": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleId"
          }
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "conflictsWith": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "unresolvedDependencies": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "moduleOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/resolvedOutcome"
        },
        {
          "$ref": "#/$defs/unknownOutcome"
        },
        {
          "$ref": "#/$defs/unsupportedOutcome"
        },
        {
          "$ref": "#/$defs/unresolvableOutcome"
        }
      ]
    },
    "inclusionReason": {
      "enum": [
        "module-selection",
        "property-dependency",
        "attacker-capability",
        "threat-capability",
        "threat-affected-property"
      ]
    },
    "selectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceModuleId",
              "inclusionReasons"
            ],
            "properties": {
              "sourceModuleId": {
                "$ref": "#/$defs/moduleId"
              },
              "inclusionReasons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/inclusionReason"
                }
              }
            }
          }
        }
      }
    },
    "propertySelectionMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/propertyId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/selectionRecord"
      }
    },
    "capabilitySelectionMap": {
      "type": "object",
      "maxProperties": 48,
      "propertyNames": {
        "$ref": "#/$defs/capabilityId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/selectionRecord"
      }
    },
    "attackerSelectionMap": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/attackerId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/selectionRecord"
      }
    },
    "threatSelectionMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/threatId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/selectionRecord"
      }
    },
    "sourceStatements": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceModuleId",
          "statement"
        ],
        "properties": {
          "sourceModuleId": {
            "$ref": "#/$defs/moduleId"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "networkRequired",
        "secretsAllowed"
      ],
      "properties": {
        "executable": {
          "const": false
        },
        "networkRequired": {
          "const": false
        },
        "secretsAllowed": {
          "const": false
        }
      }
    }
  }
}
