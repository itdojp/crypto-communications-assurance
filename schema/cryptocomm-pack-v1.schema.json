{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itdojp/crypto-communications-assurance/schema/cryptocomm-pack-v1.schema.json",
  "title": "Cryptographic Communications Assurance Bootstrap Pack v1",
  "description": "Closed, data-only bootstrap contract. It grants no approval, certification, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "sourceRevision",
    "compatibility",
    "artifacts",
    "executable",
    "networkRequired",
    "secretsAllowed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cryptocomm-pack/v1"
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sourceRevision": {
      "description": "Lowercase 40-character Git commit object name for the source of this pack.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aeFramework", "genaiRepoAuditor"],
      "properties": {
        "aeFramework": {
          "$ref": "#/$defs/compatibilityDeclaration"
        },
        "genaiRepoAuditor": {
          "$ref": "#/$defs/compatibilityDeclaration"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "executable": {
      "const": false
    },
    "networkRequired": {
      "const": false
    },
    "secretsAllowed": {
      "const": false
    }
  },
  "$defs": {
    "compatibilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "status"],
      "properties": {
        "contractVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "enum": ["planned", "compatible", "unsupported"]
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "description": "Bounded repository-relative POSIX path; absolute paths, backslashes, and dot traversal segments are forbidden.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "description": "Lowercase hexadecimal SHA-256 digest of the referenced artifact bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
