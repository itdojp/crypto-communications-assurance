{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itdojp/crypto-communications-assurance/schema/cryptocomm-attacker-catalog-v1.schema.json",
  "title": "Cryptographic Communication Attacker Catalog v1",
  "description": "Closed catalog separating attacker operations and access conditions from bounded attacker models. Models express scope, not universal product requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogVersion",
    "capabilities",
    "attackers",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cryptocomm-attacker-catalog/v1"
    },
    "catalogId": {
      "$ref": "#/$defs/catalogId"
    },
    "catalogVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 48,
      "propertyNames": {
        "$ref": "#/$defs/capabilityId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/capabilityEntry"
      }
    },
    "attackers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/attackerId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attackerEntry"
      }
    },
    "safety": {
      "$ref": "#/$defs/safetyBoundary"
    },
    "fixtureClassification": {
      "description": "Explicit non-authoritative marker used only by committed synthetic fixtures.",
      "const": "synthetic-test-only"
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+(?:\\.(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "definition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "boundedStatements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "sourceRefs": {
      "description": "Explanatory primary-source section identifiers. References do not create a compliance or compatibility claim.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9.-]{1,63}:section-[A-Za-z0-9.-]{1,64}$"
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "networkRequired",
        "secretsAllowed"
      ],
      "properties": {
        "executable": {
          "const": false
        },
        "networkRequired": {
          "const": false
        },
        "secretsAllowed": {
          "const": false
        }
      }
    },
    "capabilityId": {
      "type": "string",
      "minLength": 14,
      "maxLength": 128,
      "pattern": "^capability\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "attackerId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 96,
      "pattern": "^attacker\\.([a-z][a-z0-9-]{0,63})$"
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "definition",
        "domain",
        "assumptions",
        "exclusions",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "domain": {
          "enum": [
            "network",
            "participation",
            "endpoint",
            "infrastructure",
            "secret-compromise",
            "time-state",
            "input-resource",
            "supply-chain",
            "observation",
            "physical"
          ]
        },
        "assumptions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "exclusions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "attackerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "definition",
        "capabilities",
        "assumptions",
        "exclusions",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/attackerId"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityId"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "exclusions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    }
  }
}
