{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itdojp/crypto-communications-assurance/schema/cryptocomm-execution-result-v1.schema.json",
  "title": "Cryptographic Communication Execution Result v1",
  "description": "Closed status-discriminated result of one declared check invocation or non-invocation. It does not establish evidence satisfaction, approval, certification, or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "check",
    "subject",
    "inputBindings",
    "producer",
    "tool",
    "environment",
    "scope",
    "status",
    "execution",
    "artifacts",
    "retryAdvisory",
    "diagnostics",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cryptocomm-execution-result/v1"
    },
    "resultId": {
      "$ref": "#/$defs/recordId"
    },
    "check": {
      "$ref": "#/$defs/check"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "inputBindings": {
      "$ref": "#/$defs/inputBindings"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "skip",
        "unsupported",
        "timeout",
        "tool-error",
        "not-run"
      ]
    },
    "execution": {},
    "artifacts": {},
    "retryAdvisory": {
      "$ref": "#/$defs/retryAdvisory"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "fixtureClassification": {
      "const": "synthetic-test-only"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    }
  },
  "$defs": {
    "boundedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "recordId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "contractId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*/v[1-9][0-9]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$"
    },
    "repositoryId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9.-]{0,31}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127})+$"
    },
    "gitSha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "git-sha1"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 127,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^(?:(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authorityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^authority\\.[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "exactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "recordId",
        "digest",
        "byteLength"
      ],
      "properties": {
        "contractId": {
          "$ref": "#/$defs/contractId"
        },
        "recordId": {
          "$ref": "#/$defs/recordId"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "exactContentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "byteLength"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "bindingFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "digest",
        "byteLength"
      ],
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/boundedId"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "contractIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "recordId"
      ],
      "properties": {
        "contractId": {
          "$ref": "#/$defs/contractId"
        },
        "recordId": {
          "$ref": "#/$defs/recordId"
        }
      }
    },
    "manifestSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifest"
      ],
      "properties": {
        "kind": {
          "const": "cca-110-manifest"
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "recordId",
            "digest",
            "byteLength"
          ],
          "properties": {
            "contractId": {
              "const": "cryptocomm-pack-manifest/v1"
            },
            "recordId": {
              "$ref": "#/$defs/recordId"
            },
            "digest": {
              "$ref": "#/$defs/sha256Digest"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        }
      }
    },
    "gitSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repositoryId",
        "commit",
        "tree"
      ],
      "properties": {
        "kind": {
          "const": "git-revision"
        },
        "repositoryId": {
          "$ref": "#/$defs/repositoryId"
        },
        "commit": {
          "$ref": "#/$defs/gitSha1"
        },
        "tree": {
          "$ref": "#/$defs/gitSha1"
        }
      }
    },
    "contractArtifactSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact"
      ],
      "properties": {
        "kind": {
          "const": "contract-artifact"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "recordId",
            "digest",
            "byteLength"
          ],
          "properties": {
            "contractId": {
              "$ref": "#/$defs/contractId"
            },
            "recordId": {
              "$ref": "#/$defs/recordId"
            },
            "digest": {
              "$ref": "#/$defs/sha256Digest"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        }
      }
    },
    "subject": {
      "oneOf": [
        {
          "$ref": "#/$defs/manifestSubject"
        },
        {
          "$ref": "#/$defs/gitSubject"
        },
        {
          "$ref": "#/$defs/contractArtifactSubject"
        }
      ]
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "digest",
        "byteLength",
        "mediaType"
      ],
      "properties": {
        "inputId": {
          "$ref": "#/$defs/boundedId"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "mediaType": {
          "$ref": "#/$defs/mediaType"
        },
        "contract": {
          "$ref": "#/$defs/contractIdentity"
        }
      }
    },
    "inputBindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "softwareIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationId",
        "version",
        "sourceRepositoryId",
        "sourceRevision"
      ],
      "properties": {
        "implementationId": {
          "$ref": "#/$defs/boundedId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sourceRepositoryId": {
          "$ref": "#/$defs/repositoryId"
        },
        "sourceRevision": {
          "$ref": "#/$defs/gitSha1"
        }
      }
    },
    "softwareProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation"
      ],
      "properties": {
        "kind": {
          "const": "software"
        },
        "implementation": {
          "$ref": "#/$defs/softwareIdentity"
        }
      }
    },
    "humanProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operatorId"
      ],
      "properties": {
        "kind": {
          "const": "human"
        },
        "operatorId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^operator\\.[A-Za-z0-9_-]{1,119}$"
        }
      }
    },
    "producer": {
      "oneOf": [
        {
          "$ref": "#/$defs/softwareProducer"
        },
        {
          "$ref": "#/$defs/humanProducer"
        }
      ]
    },
    "identifiedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "toolId",
        "version",
        "implementation"
      ],
      "properties": {
        "kind": {
          "const": "identified"
        },
        "toolId": {
          "$ref": "#/$defs/boundedId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "implementation": {
          "$ref": "#/$defs/softwareIdentity"
        }
      }
    },
    "notApplicableTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "not-applicable"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "tool": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifiedTool"
        },
        {
          "$ref": "#/$defs/notApplicableTool"
        }
      ]
    },
    "recordedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "environmentId",
        "operatingSystem",
        "architecture"
      ],
      "properties": {
        "kind": {
          "const": "recorded"
        },
        "environmentId": {
          "$ref": "#/$defs/boundedId"
        },
        "operatingSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "runtimeVersion": {
          "$ref": "#/$defs/version"
        },
        "immutableImageDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "notRecordedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "not-recorded"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "environment": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordedEnvironment"
        },
        {
          "$ref": "#/$defs/notRecordedEnvironment"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeId",
        "description",
        "exclusions"
      ],
      "properties": {
        "scopeId": {
          "$ref": "#/$defs/boundedId"
        },
        "description": {
          "$ref": "#/$defs/boundedText"
        },
        "exclusions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/boundedText"
          },
          "uniqueItems": true
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "networkRequired",
        "secretsAllowed"
      ],
      "properties": {
        "executable": {
          "const": false
        },
        "networkRequired": {
          "const": false
        },
        "secretsAllowed": {
          "const": false
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 96,
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "criteriaId",
        "criteriaVersion"
      ],
      "properties": {
        "checkId": {
          "$ref": "#/$defs/boundedId"
        },
        "criteriaId": {
          "$ref": "#/$defs/boundedId"
        },
        "criteriaVersion": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "role"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/boundedId"
        },
        "role": {
          "enum": [
            "substantive-result",
            "partial",
            "diagnostic",
            "log"
          ]
        }
      }
    },
    "artifactRefNonSubstantive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "role"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/boundedId"
        },
        "role": {
          "enum": [
            "partial",
            "diagnostic",
            "log"
          ]
        }
      }
    },
    "artifactRefDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "role"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/boundedId"
        },
        "role": {
          "enum": [
            "diagnostic",
            "log"
          ]
        }
      }
    },
    "artifactsAll": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "artifactsNonSubstantive": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifactRefNonSubstantive"
      }
    },
    "artifactsDiagnostic": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifactRefDiagnostic"
      }
    },
    "retryAdvisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisoryOnly",
        "meaningful",
        "reason"
      ],
      "properties": {
        "advisoryOnly": {
          "const": true
        },
        "meaningful": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "completedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "attempted": {
          "const": true
        },
        "occurred": {
          "const": true
        },
        "completed": {
          "const": true
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "skipExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "decisionId",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "attempted": {
          "const": false
        },
        "occurred": {
          "const": false
        },
        "completed": {
          "const": false
        },
        "decisionId": {
          "$ref": "#/$defs/boundedId"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "unsupportedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "supportScope",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "attempted": {
          "const": false
        },
        "occurred": {
          "const": false
        },
        "completed": {
          "const": false
        },
        "supportScope": {
          "$ref": "#/$defs/boundedText"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "timeoutExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "startedAt",
        "timeLimitMilliseconds",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "attempted": {
          "const": true
        },
        "occurred": {
          "const": true
        },
        "completed": {
          "const": false
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "timeLimitMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "toolErrorPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "phase",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "attempted": {
          "const": true
        },
        "occurred": {
          "const": false
        },
        "completed": {
          "const": false
        },
        "phase": {
          "const": "preflight"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "toolErrorExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "phase",
        "startedAt",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "attempted": {
          "const": true
        },
        "occurred": {
          "const": true
        },
        "completed": {
          "const": false
        },
        "phase": {
          "enum": [
            "execution",
            "post-processing"
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "toolErrorExecutionAny": {
      "oneOf": [
        {
          "$ref": "#/$defs/toolErrorPreflight"
        },
        {
          "$ref": "#/$defs/toolErrorExecution"
        }
      ]
    },
    "notRunExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "occurred",
        "completed",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "attempted": {
          "const": false
        },
        "occurred": {
          "const": false
        },
