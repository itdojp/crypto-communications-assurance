{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itdojp/crypto-communications-assurance/schema/cryptocomm-threat-catalog-v1.schema.json",
  "title": "Cryptographic Communication Threat Catalog v1",
  "description": "Closed protocol-neutral catalog of bounded adverse events or paths. A threat is not a confirmed vulnerability, risk score, mitigation, or decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogVersion",
    "threats",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cryptocomm-threat-catalog/v1"
    },
    "catalogId": {
      "$ref": "#/$defs/catalogId"
    },
    "catalogVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "threats": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 40,
      "propertyNames": {
        "$ref": "#/$defs/threatId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/threatEntry"
      }
    },
    "safety": {
      "$ref": "#/$defs/safetyBoundary"
    },
    "fixtureClassification": {
      "description": "Explicit non-authoritative marker used only by committed synthetic fixtures.",
      "const": "synthetic-test-only"
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+(?:\\.(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "definition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "boundedStatements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "sourceRefs": {
      "description": "Explanatory primary-source section identifiers. References do not create a compliance or compatibility claim.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9.-]{1,63}:section-[A-Za-z0-9.-]{1,64}$"
      }
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "networkRequired",
        "secretsAllowed"
      ],
      "properties": {
        "executable": {
          "const": false
        },
        "networkRequired": {
          "const": false
        },
        "secretsAllowed": {
          "const": false
        }
      }
    },
    "threatId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^threat\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "propertyId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^property\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 14,
      "maxLength": 128,
      "pattern": "^capability\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "threatEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "definition",
        "category",
        "capabilities",
        "affectedProperties",
        "preconditions",
        "assumptions",
        "exclusions",
        "impact",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/threatId"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "category": {
          "enum": [
            "confidentiality",
            "integrity",
            "authentication",
            "binding",
            "replay-ordering",
            "randomness",
            "key-management",
            "downgrade-agility",
            "compromise-recovery",
            "metadata-privacy",
            "resilience",
            "evidence-publication"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capabilityId"
          }
        },
        "affectedProperties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/propertyId"
          }
        },
        "preconditions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "assumptions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "exclusions": {
          "$ref": "#/$defs/boundedStatements"
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    }
  }
}
