{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itdojp/crypto-communications-assurance/schema/cryptocomm-profile-request-v1.schema.json",
  "title": "Cryptographic Communication Profile Request v1",
  "description": "Closed explicit operator selection of capability-module identifiers bound to exact module-catalog bytes. A request is not approval, policy, execution, or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "moduleCatalog",
    "requestedModules",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cryptocomm-profile-request/v1"
    },
    "profileId": {
      "$ref": "#/$defs/profileId"
    },
    "moduleCatalog": {
      "$ref": "#/$defs/moduleCatalogBinding"
    },
    "requestedModules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "safety": {
      "$ref": "#/$defs/safetyBoundary"
    },
    "fixtureClassification": {
      "const": "synthetic-test-only"
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+(?:\\.(?!0[0-9]+(?:\\.|\\+|$))[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "moduleCatalogBinding": {
      "description": "Exact-byte binding of the capability-module catalog selected by the request.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "catalogId",
        "catalogVersion",
        "digest"
      ],
      "properties": {
        "contractId": {
          "const": "cryptocomm-capability-module-catalog/v1"
        },
        "catalogId": {
          "$ref": "#/$defs/catalogId"
        },
        "catalogVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "moduleId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^module\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "profileId": {
      "type": "string",
      "minLength": 11,
      "maxLength": 128,
      "pattern": "^profile\\.([a-z][a-z0-9-]{0,31})\\.([a-z][a-z0-9-]{0,63})$"
    },
    "safetyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "networkRequired",
        "secretsAllowed"
      ],
      "properties": {
        "executable": {
          "const": false
        },
        "networkRequired": {
          "const": false
        },
        "secretsAllowed": {
          "const": false
        }
      }
    }
  }
}
